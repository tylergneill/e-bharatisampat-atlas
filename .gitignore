# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Unit test / coverage
.pytest_cache/
.coverage

# mypy
.mypy_cache/

# PyCharm
.idea/

# macOS
.DS_Store

# Intermediate pipeline artifacts, regenerable from the snapshot via
# `make parse`. Also holds ad hoc fetched texts. Not published.
# Leading slash anchors this to the repo root -- a bare `data/` would also
# match docs/data/, which is published and must stay tracked.
#
# This also covers two things that must NEVER be committed: `clearance.json`
# (live session credentials) and `clearance_profile/` (session state).
# If either is ever moved out of data/, it needs its own rule here.
/data/

# The snapshot track's output. tree.json IS committed -- GitHub Pages serves it
# -- but this one is a local cross-check against the third-party snapshot,
# reachable only via `make serve-snapshot`. It covers 21% of the catalogue with
# borrowed text, and it dies with the rest of the snapshot track.
/docs/data/snapshot_tree.json

# Local operator scratch scripts for the tier-3 run. Deliberately NOT
# committed: they hardcode this machine's absolute paths and pyenv interpreter.
#
# The two that were worth keeping -- the hourly progress report and its cron
# schedule -- now live in `rivulet/ops/` with their paths parameterized, since
# they monitor rivulet's fetcher and rivulet is private.
/bin/
notes/samples/catalogue-2026-08-10.jsonl

# A git bundle of this repo's history plus a plain-text digest, kept locally
# as a backup. Large, redundant with the repo itself, and never published.
/notes/githistory/
